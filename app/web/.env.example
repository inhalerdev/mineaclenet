# Copy to .env.local (on your computer) or to the server's shared env file.
# Never commit real values. Comments stay on their own lines so this file
# works with Next.js, `node --env-file`, and systemd EnvironmentFile alike.

# --- Core database (MariaDB) ---------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
# Required. The older name DB_USER also works.
DB_USERNAME=
# Required.
DB_PASSWORD=
# Required. The older name CORE_DB_NAME also works.
DB_CORE_NAME=
DB_CHARSET=utf8mb4

# --- LiteBans database (punishments page) --------------------------------
LITEBANS_DB_HOST=127.0.0.1
LITEBANS_DB_PORT=3306
# Required.
LITEBANS_DB_USERNAME=
# Required.
LITEBANS_DB_PASSWORD=
LITEBANS_DB_NAME=mineacle_litebans
LITEBANS_DB_CHARSET=utf8mb4

# --- Player sessions ---------------------------------------------------------
# Days a player stays signed in (capped at 90)
MINEACLE_SESSION_DAYS=30

# --- Minecraft server status -------------------------------------------------
MINECRAFT_SERVER_ADDRESS=mineacle.net

# --- Website address -----------------------------------------------------------
# The website's public address, used for link preview images.
# Only needed if it isn't https://mineacle.net.
SITE_URL=https://mineacle.net

# --- Media (baked in at build time) ------------------------------------------
# R2 custom domain for the hero video, e.g. https://media.mineacle.net
NEXT_PUBLIC_MEDIA_BASE_URL=
# Optional still image shown before the hero video plays
NEXT_PUBLIC_HERO_POSTER_URL=

# --- Marketplace (Tebex) -----------------------------------------------------
# The store's Public Token (Tebex panel > Developers > API keys), looks like
# "xxxx-1234abcd...". Leave empty to show "restocking" on /marketplace.
TEBEX_PUBLIC_TOKEN=
# Optional, server only: the Tebex Private Key (same API keys page). With
# it, checkout passes each player's IP to Tebex for its fraud and region
# checks; without it checkout still works, tied to the web server's IP.
TEBEX_PRIVATE_KEY=

# Optional: the Marketplace's featured package (big banner at the top and the
# cart upsell), as a Tebex package id or exact name. Left blank, the first
# package named like "Mineacle+" / "Mineacle Plus" is featured.
TEBEX_FEATURED_PACKAGE=
