# Copy to .env.local (on your computer) or to the server's shared env file.
# Never commit real values. Comments stay on their own lines so this file
# works with Next.js, `node --env-file`, and systemd EnvironmentFile alike.

# --- Core database (MariaDB) ---------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
# Required. The older name DB_USER also works.
DB_USERNAME=
# Required.
DB_PASSWORD=
# Required. The older name CORE_DB_NAME also works.
DB_CORE_NAME=
DB_CHARSET=utf8mb4

# --- LiteBans database (punishments page) --------------------------------
LITEBANS_DB_HOST=127.0.0.1
LITEBANS_DB_PORT=3306
# Required.
LITEBANS_DB_USERNAME=
# Required.
LITEBANS_DB_PASSWORD=
LITEBANS_DB_NAME=mineacle_litebans
LITEBANS_DB_CHARSET=utf8mb4

# --- Development gateway (/admin) ------------------------------------------
# Required. Generate the hash and secret with:  pnpm gate:hash
ADMIN_GATE_USERNAME=
# Base64 value printed by gate:hash (a raw $2b$... hash gets mangled in .env files)
ADMIN_GATE_PASSWORD_HASH=
# 32+ random characters
ADMIN_GATE_SECRET=
ADMIN_GATE_SESSION_HOURS=12

# --- Player sessions ---------------------------------------------------------
# Days a player stays signed in (capped at 90)
MINEACLE_SESSION_DAYS=30

# --- Minecraft server status -------------------------------------------------
MINECRAFT_SERVER_ADDRESS=mineacle.net

# --- Media (baked in at build time) ------------------------------------------
# R2 custom domain for the hero video, e.g. https://media.mineacle.net
NEXT_PUBLIC_MEDIA_BASE_URL=
# Optional still image shown before the hero video plays
NEXT_PUBLIC_HERO_POSTER_URL=
