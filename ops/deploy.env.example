# /etc/mineacle/deploy.env: settings for ops/deploy.sh (all optional).
# Values shown are the defaults.

# Where to pull from
REPO_URL=https://github.com/inhalerdev/mineaclenet.git
BRANCH=main

# Folder that holds releases/, current, shared/env/, logs/, state/
DEPLOY_ROOT=/srv/mineacle

# Folder inside the repo that contains the Next.js package.json
APP_SUBDIR=app/web

# How to restart the site after switching releases
RESTART_CMD="sudo -n /usr/bin/systemctl restart mineacle-web"

# Must answer HTTP 200 after a restart, or the deploy rolls back
HEALTH_URL=http://127.0.0.1:3000/api/server/status
HEALTH_TIMEOUT_SECONDS=60

# Old release folders to keep for rollbacks (the live one is always kept)
KEEP_RELEASES=5

# 1 = run scripts/migrate.mjs before switching (creates missing web tables)
RUN_MIGRATIONS=0

# Leave empty to use the pnpm version pinned in package.json
PNPM_BIN=
